<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Parallel Browsers Suite" parallel="classes" thread-count="3">

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.globant.automation.web.tests.LoginWebTest"/>
            <class name="com.globant.automation.web.tests.PurchaseWebTest"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.globant.automation.web.tests.LoginWebTest"/>
            <class name="com.globant.automation.web.tests.PurchaseWebTest"/>
        </classes>
    </test>

    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.globant.automation.web.tests.LoginWebTest"/>
            <class name="com.globant.automation.web.tests.PurchaseWebTest"/>
        </classes>
    </test>

</suite>
